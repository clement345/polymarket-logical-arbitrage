# ── REQUIRED ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://poly:poly@localhost:5432/polymarket

# ── OPTIONAL (public API, defaults work) ──────────────────────────────────
GAMMA_API_BASE=https://gamma-api.polymarket.com
FETCH_INTERVAL_SECONDS=60

# ── OPTIONAL (WebSocket real-time prices) ─────────────────────────────────
# Free: create an account on polymarket.com → Settings → API Keys
# Without these, paper_trading.py falls back to DB prices (60s stale)
CLOB_HOST=https://clob.polymarket.com
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# ── OPTIONAL (live execution only) ────────────────────────────────────────
# Only needed for execution.py with DRY_RUN=false
CLOB_PRIVATE_KEY=0x...
CAPITAL_USDC=1000.0
PAPER_CAPITAL_USDC=1000.0
DRY_RUN=true
